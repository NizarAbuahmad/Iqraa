# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Local env
.env
.env.local
.env.*.local

# Math verifier local artifacts
artifacts/math-verifier/.venv/
artifacts/math-verifier/prove_slice_report.json
# Python bytecode, anywhere. Scoping this to math-verifier was fine while that
# was the only place python ran; `scripts/` now has importers too, and a rule
# has to be as wide as the places python actually runs.
__pycache__/
**/__pycache__/
*.py[cod]

# Large teacher PDF support packs (catalog JSON is committed; binaries stay local)
knowledge-base/**/support-pdfs/
knowledge-base/**/*.pdf

# Replit
.cache/
.local/
.config/

# Provider-evaluation output (generated content + raw model responses)
eval-out/

# Claude Code — local state is ignored, checked-in shared config is not.
# `.claude/skills/` holds the vendored Superpowers skills and
# `.claude/hooks/` + `.claude/settings.json` wire them up; see
# `.claude/SUPERPOWERS.md`. Everything else under `.claude/` is per-machine —
# `worktrees/` and `plugins/` included, which is why this is `.claude/*` plus
# negations rather than an un-ignore of the whole directory.
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/hooks/
!.claude/scripts/
!.claude/SUPERPOWERS.md
!.claude/LICENSE-superpowers
.claude/settings.local.json

# Byte-compiled helpers for scripts/ — regenerated on every run.
scripts/__pycache__/

# Firebase service-account private keys. The FCM V1 key is uploaded to EAS and
# lives nowhere in this repo — it can send push as us and read Firebase
# resources, so a commit of one is a rotate-immediately incident.
# NOTE: google-services.json is NOT secret and IS committed — it ships inside
# the APK and only identifies the Firebase project to the client.
*firebase-adminsdk*.json
*-service-account*.json
