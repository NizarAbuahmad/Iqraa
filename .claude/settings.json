{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm run typecheck:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm run typecheck:libs:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm run build:*)",
      "Bash(pnpm run dev:*)",
      "Bash(pnpm --filter @workspace/api-server run build:*)",
      "Bash(pnpm --filter @workspace/api-server run test:*)",
      "Bash(pnpm --filter @workspace/mobile run test:*)",
      "Bash(pnpm --filter @workspace/db run generate:*)",
      "Bash(node --test:*)",
      "Bash(npx tsc:*)",
      "Bash(python -X utf8 test_equations.py)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git remote -v)",
      "Bash(git worktree list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.*.local)",
      "Read(**/*firebase-adminsdk*.json)",
      "Read(**/*-service-account*.json)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "Bash(cat *.env)",
      "Bash(cat *.env *)",
      "Bash(type *.env)",
      "Bash(grep * .env)",
      "Bash(grep * **/.env)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(gcloud run revisions describe:*)",
      "Bash(gcloud secrets versions access:*)",
      "Bash(pnpm --filter @workspace/db run push:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/superpowers-session-start.sh\"",
            "shell": "bash",
            "async": false
          }
        ]
      }
    ]
  }
}
