# =============================================================================
# Iqraa — environment template
# =============================================================================
# Copy to ".env" in the repository root:
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# The local launchers (pnpm run dev:api / dev:mobile) load this file automatically.
# Never commit a real ".env" file.
#
# Legend:
#   [REQUIRED]  — needed for that component to work as intended
#   [OPTIONAL]  — has a safe local default, or only needed for a specific feature
#   [LEGACY]    — Replit-era names; still accepted, not required locally
# =============================================================================


# -----------------------------------------------------------------------------
# API server  (@workspace/api-server)   →  pnpm run dev:api
# -----------------------------------------------------------------------------

# [OPTIONAL] Listen port. Local launcher defaults to 8080 if unset.
PORT=8080

# [OPTIONAL] development | production. Local launcher defaults to development.
NODE_ENV=development

# [OPTIONAL] Pino log level. Default: info
LOG_LEVEL=info

# [REQUIRED for auth/workspace] PostgreSQL connection string.
# Create DB first, then:  pnpm --filter @workspace/db run push
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iqraa

# [REQUIRED for auth] JWT / session signing secret (use a long random string in prod).
SESSION_SECRET=local-dev-session-secret-change-me

# [REQUIRED for AI chat/generate] Prefer standard OpenAI names locally:
OPENAI_API_KEY=sk-your-key-here
# [OPTIONAL] Defaults to https://api.openai.com/v1 if unset.
OPENAI_BASE_URL=https://api.openai.com/v1

# [LEGACY] Same as OPENAI_* — still accepted if you already use these names:
# AI_INTEGRATIONS_OPENAI_API_KEY=sk-your-key-here
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# [OPTIONAL] Live-AI test switch for the OpenAI-backed routes (chat, generate,
# derivativeVerified). Must be exactly "true" to enable — any other value (or
# unset) keeps them off, even with a valid OPENAI_API_KEY above. This is the
# server-side counterpart to EXPO_PUBLIC_DEMO_MODE below; you need both off/false
# to actually reach OpenAI end to end.
# AI_LIVE_MODE=true

# [OPTIONAL] Hard USD cap on estimated OpenAI spend while AI_LIVE_MODE is on.
# In-process only — resets on server restart, and isn't a substitute for the
# usage limit you should also set on the OpenAI account (Settings → Billing).
# Default: 2 (dollars). Check current spend at GET /api/healthz/ai-budget.
# AI_BUDGET_USD=2

# [OPTIONAL] Chat model for the live-AI routes above. Default: gpt-4o-mini
# (cheap — the point of the default is affordable testing, not top quality).
# AI_MODEL=gpt-4o-mini

# [OPTIONAL] Set this to see the last 50 server errors at GET /api/healthz/errors
# (send it back as the "x-admin-key" header). Unset by default — the endpoint
# 404s, as if it doesn't exist, until you set a key.
# ADMIN_DEBUG_KEY=pick-a-random-string

# [OPTIONAL] SymPy math-verifier microservice (derivative vertical slice).
# Start: cd artifacts/math-verifier && uvicorn app:app --port 8090
MATH_VERIFIER_URL=http://127.0.0.1:8090

# [OPTIONAL] Unsplash access key — Slides Maker fetches one topic-relevant
# photo per generated deck when set. Free "Demo" tier (50 req/hour) is enough
# for local dev: https://unsplash.com/oauth/applications. Unset means Slides
# Maker skips the image slide entirely — never a failure, just no photo.
# UNSPLASH_ACCESS_KEY=your-access-key-here

# [OPTIONAL] YouTube Data API key — Slides Maker searches for one real,
# existing explainer video per lesson (never generated) when set. Free quota:
# 10,000 units/day, ~100 searches. Get one at https://console.cloud.google.com
# (enable "YouTube Data API v3", create an API key under Credentials — no
# OAuth needed, this is a public search-only key). Unset means Slides Maker
# skips the video slide entirely — never a failure, just no video.
# YOUTUBE_API_KEY=your-api-key-here


# -----------------------------------------------------------------------------
# Mobile / web frontend  (@workspace/mobile)   →  pnpm run dev:mobile[:web]
# -----------------------------------------------------------------------------

# [OPTIONAL] Expo packager port. Launcher defaults to 8081 (avoids API PORT clash).
MOBILE_PORT=8081

# [REQUIRED for reliable client] Absolute API base URL used by the Expo app.
# Dev launcher defaults to http://localhost:8080/api if unset (and EXPO_PUBLIC_DOMAIN unset).
# Also copy this into artifacts/mobile/.env so Expo's own env loader sees it.
# Production/static builds REJECT localhost here unless ALLOW_LOCALHOST_API=1.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api

# [OPTIONAL] Alternate API host. Bare hostname → https://{host}/api (hosted style).
# Full URL (http://...) is also accepted. Prefer EXPO_PUBLIC_API_BASE_URL locally.
# EXPO_PUBLIC_DOMAIN=localhost:8080

# [OPTIONAL] Override API port when constructing the default EXPO_PUBLIC_API_BASE_URL.
# API_PORT=8080

# [OPTIONAL] Allow baking localhost into a static/mobile build (local test only).
# ALLOW_LOCALHOST_API=1

# [OPTIONAL] Enable internal Curriculum Quality Validation UI at /dev/cqv
# (__DEV__ builds already enable CQV). Never surface in Investor MVP chrome.
# EXPO_PUBLIC_ENABLE_CQV=1

# [OPTIONAL] PostHog project API key — teacher-pilot usage analytics (screens
# visited, tools opened, materials saved/exported). PostHog project keys are
# meant to be client-embedded, unlike OPENAI_API_KEY/UNSPLASH_ACCESS_KEY above
# — no server proxy needed. Unset means every analytics call is a silent
# no-op; nothing about the app's behavior changes either way. Free tier
# (1M events/month) is enough for a pilot: https://posthog.com
# Also copy into artifacts/mobile/.env; requires a dev-server restart.
# EXPO_PUBLIC_POSTHOG_API_KEY=phc_your-project-api-key
# [OPTIONAL] Defaults to PostHog Cloud US. Use https://eu.i.posthog.com for the EU cloud.
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# [OPTIONAL] Set to "false" to call the real API (chat/generate) instead of the
# built-in mock generators — pairs with AI_LIVE_MODE=true above. Any other
# value, or unset, keeps the safe default (demo mode on, no network AI calls).
# Also copy into artifacts/mobile/.env; requires a dev-server restart to take effect.
# EXPO_PUBLIC_DEMO_MODE=false

# [OPTIONAL] Set to "true" to refuse the mock fallback when a live AI call
# fails: the screen shows an error instead of sample content. Only meaningful
# with EXPO_PUBLIC_DEMO_MODE=false. Useful while confirming live AI is really
# on — with the fallback in place, a bad key still produces a full lesson plan.
# EXPO_PUBLIC_AI_STRICT_LIVE=true

# [OPTIONAL] Expo Router absolute origin (also baked into app.json as http://localhost:8081).
# EXPO_PUBLIC_APP_ORIGIN=http://localhost:8081

# [OPTIONAL] Static web export base path for `pnpm --filter @workspace/mobile run build|serve`.
# BASE_PATH=/


# -----------------------------------------------------------------------------
# Design sandbox  (@workspace/mockup-sandbox)   →  NOT the product UI
# -----------------------------------------------------------------------------

# [OPTIONAL] Local launcher defaults: PORT=8082, BASE_PATH=/
MOCKUP_PORT=8082
# BASE_PATH=/


# -----------------------------------------------------------------------------
# Replit-only (NOT required for Cursor / local Windows)
# -----------------------------------------------------------------------------
# These are ignored by the local launchers. Kept here only as a reference.
# REPLIT_DEV_DOMAIN=
# REPLIT_EXPO_DEV_DOMAIN=
# REPLIT_INTERNAL_APP_DOMAIN=
# REPL_ID=
# EXPO_PUBLIC_REPL_ID=
# EXPO_PACKAGER_PROXY_URL=
# REACT_NATIVE_PACKAGER_HOSTNAME=
