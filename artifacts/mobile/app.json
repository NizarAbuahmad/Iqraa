{
  "expo": {
    "name": "IQRA | اقرأ",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#081B3A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.iqra.teachingassistant"
    },
    "android": {
      "package": "com.iqra.teachingassistant",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#081B3A",
        "monochromeImage": "./assets/images/adaptive-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#081B3A",
      "name": "IQRA | اقرأ",
      "shortName": "IQRA",
      "themeColor": "#081B3A"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "http://localhost:8081"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "83fc6522-3051-4916-a830-35e0d88f9dd2"
      }
    },
    "owner": "nizar.62"
  }
}
