{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    // Tests import with explicit .ts extensions because node --experimental-strip-types
    // requires them. The build is esbuild, not tsc, so nothing here needs to emit.
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../lib/db"
    },
    {
      "path": "../../lib/api-zod"
    },
    {
      "path": "../../lib/curriculum"
    },
    {
      "path": "../../lib/integrations-openai-ai-server"
    }
  ]
}
