{
  "name": "@workspace/curriculum",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./catalog": "./src/catalog.ts",
    "./objectives": "./src/objectives.ts",
    "./blooms": "./src/blooms.ts",
    "./sources": "./src/sources.ts",
    "./bank": "./src/bank.ts",
    "./external": "./src/external.ts",
    "./passages": "./src/passages.ts",
    "./catalogs/*": "./src/catalogs/*.ts",
    "./validateCurriculum": "./src/validateCurriculum.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node --experimental-strip-types scripts/verify-curriculum.ts",
    "test": "node --experimental-strip-types --test \"src/**/__tests__/**/*.test.ts\"",
    "extract-text": "node --experimental-strip-types scripts/extract-text.ts",
    "upload-r2": "node --experimental-strip-types scripts/upload-to-r2.ts",
    "audit-r2": "node --experimental-strip-types scripts/audit-r2.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.699.0",
    "@types/node": "catalog:",
    "pdf-parse": "^2.4.5"
  }
}
